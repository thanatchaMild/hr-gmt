DB_CONNECTION=sqlserver
DB_HOST=192.168.8.93
DB_PORT=1433
DB_DATABASE=hr-test
DB_USERNAME=sa
DB_PASSWORD=CHANGE_ME

# Second database connection (e.g. a read replica). Leave blank if not used.
DB_CONNECTION_2=
DB_HOST_2=
DB_PORT_2=
DB_DATABASE_2=
DB_USERNAME_2=
DB_PASSWORD_2=

# Built from DB_* above — required as-is by the Prisma CLI (db push / generate / studio),
# which reads this directly and cannot compose a URL from separate vars itself.
# Keep this in sync with DB_* if you change them.
DATABASE_URL="sqlserver://192.168.8.93:1433;database=hr-test;user=sa;password=CHANGE_ME;trustServerCertificate=true;encrypt=true"

NUXT_SESSION_PASSWORD="replace-with-a-random-32-character-or-longer-secret"
