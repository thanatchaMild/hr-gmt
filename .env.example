DB_CONNECTION=sqlserver
DB_HOST=192.168.8.93
DB_PORT=1433
DB_DATABASE=hr-test
DB_USERNAME=sa
DB_PASSWORD=CHANGE_ME

# Second database connection (e.g. a read replica). Leave blank if not used.
DB_CONNECTION_2=
DB_HOST_2=
DB_PORT_2=
DB_DATABASE_2=
DB_USERNAME_2=
DB_PASSWORD_2=

# Built from DB_* above — required as-is by the Prisma CLI (db push / generate / studio),
# which reads this directly and cannot compose a URL from separate vars itself.
# Keep this in sync with DB_* if you change them.
DATABASE_URL="sqlserver://192.168.8.93:1433;database=hr-test;user=sa;password=CHANGE_ME;trustServerCertificate=true;encrypt=true"

NUXT_SESSION_PASSWORD="replace-with-a-random-32-character-or-longer-secret"

# Where uploaded files (documents, photos) are stored on disk.
# Dev can leave this blank — it falls back to ./server/uploads.
# Production MUST set an absolute path on a PERSISTENT volume; otherwise every
# redeploy wipes uploaded files and opening them returns 404.
# e.g. NUXT_UPLOAD_DIR=/var/lib/hr-management/uploads
NUXT_UPLOAD_DIR=

# AppSheet DB (IT asset inventory - read-only)
DB_HOST_APPSHEET=
DB_PORT_APPSHEET=1433
DB_DATABASE_APPSHEET=appsheetdb
DB_USERNAME_APPSHEET=
DB_PASSWORD_APPSHEET=

# myapp main DB (gypman-tech) - IT asset requests / catalog (read-only)
DB_HOST_GYPMAN=
DB_PORT_GYPMAN=1433
DB_DATABASE_GYPMAN=gypman-tech
DB_USERNAME_GYPMAN=
DB_PASSWORD_GYPMAN=

# Passwords prisma/seed.ts gives the demo users (blank = "password")
SEED_PASSWORD_HR_DAILY=
SEED_PASSWORD_HR_MONTHLY=
SEED_PASSWORD_HR_MANAGER=
SEED_PASSWORD_IT_ADMIN=
